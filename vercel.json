{
  "buildCommand": "node scripts/vercel-rotas-curtas.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/hub",
      "destination": "/pages/hub/hub"
    },
    {
      "source": "/tarefas",
      "destination": "/pages/controladoria/tarefas/tarefas"
    },
    {
      "source": "/equipe",
      "destination": "/pages/controladoria/equipe/equipe"
    },
    {
      "source": "/ferias",
      "destination": "/pages/controladoria/ferias/ferias"
    },
    {
      "source": "/automacoes",
      "destination": "/pages/controladoria/automacoes/automacoes"
    },
    {
      "source": "/bp",
      "destination": "/pages/demonstracoes/bp/bp"
    },
    {
      "source": "/dr",
      "destination": "/pages/demonstracoes/dr/dr"
    },
    {
      "source": "/dmpl",
      "destination": "/pages/demonstracoes/dmpl/dmpl"
    },
    {
      "source": "/dfc",
      "destination": "/pages/demonstracoes/dfc/dfc"
    },
    {
      "source": "/composicao",
      "destination": "/pages/controles/composicao/composicao"
    },
    {
      "source": "/analitico",
      "destination": "/pages/controles/analitico/analitico"
    },
    {
      "source": "/peps",
      "destination": "/pages/controles/peps/peps"
    },
    {
      "source": "/ordens",
      "destination": "/pages/controles/ordens/ordens_inv"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}